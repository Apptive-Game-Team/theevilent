# Base URL of the lobby server (rankings, magic statistics, and the account page).
# Leave unset to use https://lobby.ac.theevilent.com.
VITE_LOBBY_BASE_URL=https://lobby.ac.theevilent.com

# Base URL of the account server (log in, sign up, account deletion).
# Leave unset to use https://account.theevilent.com.
VITE_ACCOUNT_BASE_URL=https://account.theevilent.com

# Cloudflare Turnstile site key for the sign-up form. Leave unset to use the
# production widget in builds and Cloudflare's always-pass test key in `npm run dev`.
# VITE_TURNSTILE_SITE_KEY=
